#!/bin/bash

# ========================================
# LumenX pre-commit hook (git-safe-push 自动化)
# 来源: .agent/workflows/git-safe-push.md 前置检查 1/2/3
# 安装: ./scripts/git-hooks/install.sh
# 跳过(仅紧急情况): SKIP_SAFE_PUSH=1 git commit ...
# ========================================

set -u

if [ "${SKIP_SAFE_PUSH:-0}" = "1" ]; then
    echo "[git-safe-push] SKIP_SAFE_PUSH=1，跳过 pre-commit 检查"
    exit 0
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAIL=0

# ---- 检查 1: 禁止在 main 分支上直接提交 ----
BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ]; then
    echo -e "${RED}[git-safe-push] ❌ 禁止在 main 分支上直接提交${NC}"
    echo -e "  请创建功能分支: ${YELLOW}./git_push.sh -n <feature-name>${NC}"
    echo -e "  紧急放行: ${YELLOW}SKIP_SAFE_PUSH=1 git commit ...${NC}"
    FAIL=1
fi

# ---- 检查 2a: 敏感文件名（.env / secret / credential / *.key / *.pem）----
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
SENSITIVE_FILES=$(echo "$STAGED" \
    | grep -E '(^|/)\.env(\..+)?$|secret|credential|\.key$|\.pem$' \
    | grep -vE '\.example$|\.sample$' || true)
if [ -n "$SENSITIVE_FILES" ]; then
    echo -e "${RED}[git-safe-push] ❌ 检测到疑似敏感文件被暂存:${NC}"
    echo "$SENSITIVE_FILES" | sed 's/^/    /'
    echo -e "  请移出暂存区: ${YELLOW}git restore --staged <file>${NC} 并加入 .gitignore"
    FAIL=1
fi

# ---- 检查 2b: 暂存内容中的疑似密钥（sk-* / 阿里云 LTAI / KEY=值）----
SECRET_PATTERN='sk-[A-Za-z0-9]{20,}|LTAI[A-Za-z0-9]{12,}|(API_KEY|SECRET|PASSWORD|ACCESS_KEY|TOKEN)[A-Z_]*[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9_/+-]{16,}'
CONTENT_HITS=$(git diff --cached -U0 -- . \
        ':(exclude)*.example' ':(exclude)*.sample' ':(exclude)scripts/git-hooks' \
    | grep -E '^\+' | grep -vE '^\+\+\+' \
    | grep -E "$SECRET_PATTERN" \
    | grep -ivE 'your[_-]|example|placeholder|xxxx' || true)
if [ -n "$CONTENT_HITS" ]; then
    echo -e "${RED}[git-safe-push] ❌ 暂存内容中检测到疑似密钥/凭证:${NC}"
    echo "$CONTENT_HITS" | head -5 | sed 's/^/    /'
    echo -e "  请改为从环境变量或 .env（已 gitignore）读取"
    FAIL=1
fi

# ---- 检查 3: .gitignore 应包含 .env 忽略规则（仅告警）----
if ! grep -qE '^\.env' .gitignore 2>/dev/null; then
    echo -e "${YELLOW}[git-safe-push] ⚠️  .gitignore 中缺少 .env 忽略规则，请补充${NC}"
fi

if [ "$FAIL" -ne 0 ]; then
    exit 1
fi

echo -e "${GREEN}[git-safe-push] ✅ pre-commit 检查通过${NC}"
exit 0
