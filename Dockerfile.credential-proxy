FROM python:3.11-slim

WORKDIR /app
COPY requirements-credential-proxy.txt /tmp/requirements-credential-proxy.txt
RUN pip install --no-cache-dir -r /tmp/requirements-credential-proxy.txt
COPY src/__init__.py src/__init__.py
COPY src/apps/platform/__init__.py src/apps/platform/__init__.py
COPY src/apps/platform/credential_proxy_service.py src/apps/platform/credential_proxy_service.py
ENV PYTHONUNBUFFERED=1
USER 65532:65532
EXPOSE 17178
CMD ["python", "-m", "src.apps.platform.credential_proxy_service"]
