# 阿里云 DashScope API Key (用于通义千问等模型)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===============================
# ComfyUI 本地模型配置 (可选)
# 图像/视频/音频生成全部走本地 ComfyUI 时配置
# ===============================
# ComfyUI 服务地址（默认 http://localhost:8188）
# COMFYUI_BASE_URL=http://localhost:8188
# 协议: zealman=ZEALMAN 控制面板 (lumenx-comfyui 默认), standard=原生 ComfyUI API
# COMFYUI_PROTOCOL=zealman
# 可选: 面板需要鉴权时填写
# COMFYUI_API_KEY=
# 本地 LLM/TTS 完整本地化时启用 ComfyUI 音频工作流 (FishAudio 等)
# COMFYUI_TTS_ENABLED=1
# 工作流映射文件 (默认 config/workflow_mapping.json)
# COMFYUI_WORKFLOW_MAPPING=config/workflow_mapping.json

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# MuleRun / MuleRouter 配置 (可选，用于 Seedance 2.0 视频生成 + GPT-Image-2 图片生成)
# 方式一 (推荐): 安装 MuleRun CLI 并登录，然后从 mulerun studio config 获取 key
#   npm i -g @mulerunai/cli && mulerun login
#   mulerun studio config  → 复制 API Key (格式: muk-...)
# 方式二: 直接用 MuleRouter API Key
# 两种 key 格式通用，填入同一变量即可：
# MULEROUTER_API_KEY=muk-your-key-here
# 站点选择 (mulerouter=默认, mulerun=更多模型但 gpt-image-2 仅 mulerouter 可用)
# MULEROUTER_SITE=mulerouter

# LLM 多模型适配 (可选)
# 默认使用 DashScope (通过 OpenAI 兼容接口调用，只需上方 DASHSCOPE_API_KEY 即可)
# LLM_PROVIDER=dashscope
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2
# MULEROUTER_BASE_URL=https://api.mulerouter.ai
