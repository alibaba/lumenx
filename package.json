{
  "name": "lumenx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-setup.js",
    "dev": "concurrently --kill-others-on-fail -n backend,frontend,open -c blue,green,cyan \"npm run dev:backend\" \"npm run dev:frontend\" \"node scripts/open-browser.js\"",
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "cross-env LUMENX_WAIT_FOR_BACKEND_RUNTIME=1 node scripts/start-frontend.js",
    "quality:frontend": "npm -C frontend run quality",
    "audit:story-fixtures": "python -m src.utils.story_fixture_audit",
    "ci:dev-smoke": "node scripts/ci-dev-smoke.js",
    "git:setup-hooks": "node scripts/git-policy.mjs setup-hooks",
    "git:check-branch": "node scripts/git-policy.mjs branch"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  }
}
