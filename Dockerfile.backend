FROM python:3.11-slim

# Install FFmpeg and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies (excluding pywebview)
COPY requirements-docker.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/
# Model defaults validate the executable catalog and its local API snapshot.
COPY config/model_catalog/ config/model_catalog/
COPY docs/1-api-reference/aliyun-wan3-shared-execution-2026-10-12.md docs/1-api-reference/aliyun-wan3-shared-execution-2026-10-12.md

# Runtime configuration, logs and media belong to the persistent user root.
RUN mkdir -p /var/lib/lumenx

# Environment
ENV NO_PROXY="*.aliyuncs.com,localhost,127.0.0.1"
ENV no_proxy="*.aliyuncs.com,localhost,127.0.0.1"
ENV PYTHONUNBUFFERED=1

EXPOSE 17177

CMD ["python", "-m", "src.lumenx_server", "--data-dir", "/var/lib/lumenx", "--host", "0.0.0.0", "--port", "17177"]
